# these are the minimum variables required to run the backend
PUBLIC_API_URL=https://anteaterapi.com/v2/rest/
PORT=8080 # should match the port on the frontend proxy under site/vite.config.ts

# below are stubs of variables/secrets for the PostgreSQL database, and google oauth
# these are necessary for features that require logging in
# DATABASE_URL=<secret>
# SESSION_SECRET=<secret>
# GOOGLE_CLIENT=<client>
# GOOGLE_SECRET=<secret>
# ADMIN_EMAILS=["<your email>"]
# ANTEATER_API_KEY=<secret>

# EXTERNAL_USER_READ_SECRET=<secret>

# MCP server (lets external AI agents help students plan, authenticated via @uci.edu Google).
# Reuses OIDC_*, DATABASE_URL, SESSION_SECRET, ANTEATER_API_KEY, and PRODUCTION_DOMAIN above.
# PRODUCTION_DOMAIN must be the absolute origin (e.g. http://localhost:8080 in dev) since it
# forms the OAuth issuer/redirect URIs. Register `${PRODUCTION_DOMAIN}/planner/api/mcp/auth/google/callback`
# as an allowed redirect URI on the Google/OIDC client.
# MCP_TOKEN_TTL_SECONDS=3600        # access-token lifetime (default 3600)
# MCP_DAILY_REQUEST_LIMIT=200       # per-student daily tool-call cap (default 200)
